.{
    .name = .zibra,
    .version = "0.0.0",
    .minimum_zig_version = "0.15.1",
    .dependencies = .{
        // For Unicode text processing
        .zg = .{
            .url = "git+https://codeberg.org/atman/zg#b5ebb3e50684613f20d745ac6b6b21c6d33e61ff",
            .hash = "zg-0.16.2-oGqU3OaMtgJLe_KwUwfcmRwJrE4Ihy2LpDEQm_rANL9J",
        },
        // For URL parsing
        .adazig = .{
            .url = "git+https://github.com/braheezy/ada-zig#18afbfbf56b86d511be356335f7f52f715963b1d",
            .hash = "adazig-4.0.0-t4eT-vJtAAAU96x1U7UJI7fmixUJiJsMfpuZurw9ETaK",
        },
        // Javascript runtime
